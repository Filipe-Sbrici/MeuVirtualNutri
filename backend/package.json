{
  "name": "mvn-backend",
  "version": "2.0.0",
  "private": true,
  "description": "API REST do aplicativo Meu Virtual Nutri (MVN) - Firebase Authentication + Cloud Firestore",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node scripts/smoke.js",
    "db:seed": "node scripts/seed-firestore.js",
    "db:seed:auth": "node scripts/seed-firestore.js --auth",
