# ----------------------------------------------------------
# Copie este arquivo para ".env" e ajuste conforme seu ambiente.
#   copy .env.example .env      (Windows CMD)
#   Copy-Item .env.example .env (PowerShell)
# ----------------------------------------------------------

PORT=3000

# ---------------- Firebase ----------------
# ID do projeto Firebase (obrigatorio em producao).
FIREBASE_PROJECT_ID=

# Credencial da conta de servico - OPCAO A:
# aponte a variavel de ambiente do sistema para o arquivo JSON:
#   setx GOOGLE_APPLICATION_CREDENTIALS "C:\caminho\serviceAccount.json"
#
# Credencial - OPCAO B:
# cole o CONTEUDO do JSON em uma unica linha aqui embaixo
# (util em hospedagens como Render/Railway):
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}

# Modo demonstracao da API (true/false):
# quando true, requisicoes sem token sao autenticadas como o usuario
# indicado no cabecalho x-demo-email (padrao ana@mvn.com). Use apenas
# para testar a API sem Firebase configurado. NUNCA use em producao.
FIREBASE_DEMO_MODE=false

# Exige que o usuario tenha confirmado o link de verificacao de e-mail
# do Firebase Auth antes de utilizar os recursos da API (true/false).
FIREBASE_REQUIRE_EMAIL_VERIFIED=true

# ---------------- Emuladores (desenvolvimento) ----------------
# Com estas variaveis a API e o seed falam com os emuladores locais
# do Firebase (npm run emulators), sem projeto real.
# FIRESTORE_EMULATOR_HOST=localhost:8080
# FIREBASE_AUTH_EMULATOR_HOST=localhost:9099

# Origens permitidas pelo CORS (separadas por virgula).
CORS_ORIGIN=*

# ---------------- Mercado Pago (Assinatura Nutricionista) ----------------
# Access Token do Mercado Pago (TEST-... para testes ou APP_USR-... para producao).
# Caso nao seja preenchido, a assinatura opera em modo simulado no Firestore.
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=
MP_BACK_URL=https://meuvirtualnutri.app/assinatura-retorno
ASSINATURA_PRECO_MENSAL=29.90
LIMITE_PACIENTES_GRATUITO=15
