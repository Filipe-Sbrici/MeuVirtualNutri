rules_version = '2';

// =====================================================================
//  Meu Virtual Nutri - Regras de seguranca do Cloud Firestore
//
//  O aplicativo Flutter NAO acessa o Firestore diretamente: toda
//  leitura/escrita passa pela API Node.js com o Admin SDK (imune a
//  estas regras). Por defesa profunda, o banco fica completamente
//  fechado para clientes diretos.
//
//  Os IDs de usuario (UID) vindos do Firebase Authentication so sao
//  validados pela API, que aplica as regras de negocio (ex.: paciente
//  so le o proprio progresso; nutricionista so edita planos de seus
//  pacientes vinculados).
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    // Fechado por padrao: nenhum cliente le ou escreve diretamente.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
