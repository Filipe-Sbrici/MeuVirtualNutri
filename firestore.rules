rules_version = '2';

// =====================================================================
//  Meu Virtual Nutri - Regras de seguranca do Cloud Firestore
//
//  Permite leitura e escrita nas colecoes do aplicativo para usuarios
//  autenticados via Firebase Authentication (request.auth != null),
//  funcionando tanto via API Node.js quanto diretamente pelo APK Android.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
